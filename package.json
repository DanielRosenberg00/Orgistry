{
  "name": "orgistry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:api": "pnpm --filter @orgistry/api run dev",
    "dev:web": "pnpm --filter @orgistry/web-demo run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:integration": "pnpm -r run test:integration",
    "test:web": "pnpm --filter @orgistry/web-demo run test",
    "build:web": "pnpm --filter @orgistry/web-demo run build",
    "db:check": "node tooling/check-schema-drift.mjs",
    "check:whitespace": "git diff --check",
    "scan:deps": "pnpm audit --prod --audit-level high && pnpm audit --dev --audit-level high",
    "scan:deps:local": "osv-scanner scan source -L pnpm-lock.yaml",
    "scan:secrets": "gitleaks git . --no-banner --redact",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:web && pnpm run build:web && pnpm run db:check && pnpm run check:whitespace",
    "validate:integration": "pnpm run db:reset:test && pnpm run test:integration",
    "build:api": "pnpm --filter @orgistry/api run build",
    "artifact:build": "docker compose -f infra/compose.production-like.yml build",
    "artifact:smoke": "bash tooling/artifact-smoke.sh",
    "demo:seed": "node tooling/demo-seed.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @orgistry/db run generate",
    "db:migrate": "pnpm --filter @orgistry/db run migrate",
    "db:reset:test": "pnpm --filter @orgistry/db run reset:test",
    "db:retention": "pnpm --filter @orgistry/api run retention",
    "db:backup": "bash tooling/db-backup.sh",
    "drill:restore": "bash tooling/db-restore-drill.sh",
    "drill:pitr": "bash tooling/db-pitr-drill.sh",
    "backup:verify-store": "node tooling/backup-ops.mjs verify-store",
    "backup:ship": "node tooling/backup-ops.mjs ship-backup",
    "backup:catalog": "node tooling/backup-ops.mjs catalog",
    "backup:health": "node tooling/backup-ops.mjs health",
    "backup:wal-health": "node tooling/backup-ops.mjs wal-health",
    "backup:prune": "node tooling/backup-ops.mjs prune",
    "backup:install-schedule": "bash tooling/backup-install-systemd.sh",
    "wal:enable": "bash tooling/pg-enable-wal-archiving.sh",
    "rehearse:restore": "bash tooling/backup-restore-rehearsal.sh",
    "rehearse:pitr": "bash tooling/backup-pitr-rehearsal.sh",
    "release:manifest": "node tooling/release-manifest.mjs",
    "deploy:preflight": "bash tooling/deploy-target-preflight.sh",
    "deploy:run": "bash tooling/deploy.sh",
    "deploy:smoke": "bash tooling/deploy-smoke.sh",
    "deploy:rollback": "bash tooling/deploy-rollback.sh",
    "deploy:evidence": "node tooling/deploy-evidence.mjs",
    "deploy:rehearsal": "bash tooling/deploy-rehearsal.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.13.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2",
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
