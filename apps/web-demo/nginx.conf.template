# Static serving for the built web demo (Sprint 23, ORG-PR-001; runtime public
# configuration added in the Sprint 26 refinement).
#
# THIS IS A TEMPLATE, NOT A FINISHED CONFIG. It is installed as
# /etc/nginx/templates/default.conf.template in nginxinc/nginx-unprivileged
# (non-root; listens on 8080). The base image's own entrypoint step
# (`20-envsubst-on-templates.sh`) renders it to /etc/nginx/conf.d/default.conf
# at container start, substituting ONLY variables matching NGINX_ENVSUBST_FILTER
# (set to ^ORGISTRY_PUBLIC_ in apps/web-demo/Dockerfile) — so nginx's own `$uri`,
# `$host`, and friends are never touched.
#
# That rendering step is what makes the web image promotable: the environment's
# public API origin arrives as container configuration instead of being compiled
# into the bundle, so one validated digest serves any environment
# (docs/deployment.md, "Runtime public configuration").
#
# Scope: serve the Vite production build with an SPA history fallback. TLS
# termination and the full security-header policy for the web origin belong to
# the fronting reverse proxy in a real deployment — the API sets its own headers
# for API responses only (docs/deployment-artifacts.md, "Security-header
# boundary").

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Baseline hardening that is safe regardless of the fronting proxy.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Runtime public configuration for the browser (Sprint 26 refinement).
    #
    # An exact-match location, so it wins over the static copy shipped in the
    # bundle (apps/web-demo/public/public-config.js, which exists only for the
    # dev server). Served from nginx itself: no writable path, no entrypoint
    # script, and nothing for the runtime user to own.
    #
    # PUBLIC BY DEFINITION — every browser receives this. Never add a value
    # here that is not safe to publish; the application refuses to start if it
    # sees a credential-shaped key (apps/web-demo/src/public-config.ts).
    #
    # `no-store` because it is deployment configuration: a cached copy would
    # survive a configuration change and point the browser at the wrong API.
    location = /public-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 'window.__ORGISTRY_PUBLIC_CONFIG__ = {"apiBaseUrl":"${ORGISTRY_PUBLIC_API_BASE_URL}","csrfHeaderName":"${ORGISTRY_PUBLIC_CSRF_HEADER_NAME}","mailpitUrl":"${ORGISTRY_PUBLIC_MAILPIT_URL}"};\n';
    }

    # Vite emits content-hashed filenames under /assets — cache them hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA history fallback: client-side routes resolve to index.html, which
    # must always be revalidated so deploys take effect immediately.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri $uri/ /index.html;
    }
}
