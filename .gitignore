# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Database backups (Sprint 25, ORG-PR-005). A logical backup contains user,
# organization, and audit data plus password/token/API-key hashes. It must
# never enter version control. `tooling/db-backup.sh` writes here by default
# and refuses to write inside .git; the drills use temporary directories.
backups/
*.dump
*.dump.sha256

# Backup programme artifacts (Sprint 28, ORG-PR-005). An encrypted artifact is
# still a backup, a WAL segment is still database content, and the encryption
# key is the one value that makes every stored backup readable. None of them
# may ever enter version control.
*.enc
wal-archive/
backup-encryption-key
backup-store-secret
backup-database-url

# Deployment artifacts (Sprint 26, ORG-PR-001). Release manifests and
# deployment evidence describe a specific build or a specific environment;
# they are workflow artifacts and host-side operational state, never
# repository content. Neither contains secrets — they are ignored because they
# are per-build/per-host, not because they are sensitive.
artifacts/
deployments/

# Local assistant/tooling state (never commit: contains local caches and
# scanner-sensitive blobs, e.g. the tokensave WAL)
.claude/
.tokensave/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
