# Orgistry environment configuration.
#
# Copy to `.env` and adjust as needed: `cp .env.example .env`.
# Every variable below maps to the Zod schema in packages/config/src/schema.ts.
# Values here are LOCAL DEVELOPMENT DEFAULTS — never commit real secrets.
#
# THIS IS NOT A PRODUCTION ENVIRONMENT FILE. Under NODE_ENV=production the
# config loader enforces a stricter policy (packages/config/src/production-policy.ts,
# documented in docs/production-config-guard.md) and REFUSES to boot with the
# development values in this file.

# ----- Runtime -----
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ----- API HTTP server -----
API_HOST=0.0.0.0
API_PORT=3000

# ----- Web demo (backend-side) -----
# Used by the API for the default CORS allow-list entry. The web demo dev server
# itself listens on http://localhost:5173 (Vite default; see apps/web-demo/vite.config.ts).
WEB_DEMO_URL=http://localhost:5173

# ----- CORS (comma-separated allow-list) -----
# Must include the web demo origin so refresh-cookie/logout (credentials: include) work.
CORS_ORIGINS=http://localhost:5173

# ----- Web demo (frontend-side, Vite) -----
# These VITE_* variables are read by the browser bundle at dev/build time
# (apps/web-demo/src/config.ts), NOT by the backend config schema. The defaults
# below match the values baked into the web demo, so you only need to set them
# if the API, CSRF header, or Mailpit UI move off their defaults.
VITE_API_BASE_URL=http://localhost:3000
VITE_CSRF_HEADER_NAME=x-orgistry-csrf
VITE_MAILPIT_URL=http://localhost:8025

# ----- PostgreSQL (durable local store) -----
# Must match the docker compose credentials below.
DATABASE_URL=postgres://orgistry:orgistry@localhost:5432/orgistry
# Separate database used by the test suites / `pnpm db:reset:test`.
TEST_DATABASE_URL=postgres://orgistry:orgistry@localhost:5432/orgistry_test

# Consumed only by infra/docker-compose.yml (Postgres container provisioning).
POSTGRES_USER=orgistry
POSTGRES_PASSWORD=orgistry
POSTGRES_DB=orgistry

# ----- Redis (auth + external-API rate limiting + readiness probe) -----
REDIS_URL=redis://localhost:6379

# ----- Account mailer (invitations + email verification) -----
# Driver selection is explicit and deterministic: mailpit | smtp | memory.
#   mailpit — local development sink (Mailpit container below); no credentials.
#   smtp    — production driver: SMTP over implicit TLS (no STARTTLS) with
#             negotiated SASL auth; requires SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD.
#   memory  — in-memory fake used by the automated test suites.
# NODE_ENV=production REFUSES mailpit and memory (production-policy.ts), so a
# production process can never silently deliver account email to a dev sink.
MAIL_DRIVER=mailpit
# Sender identity on every account email. LOCAL-ONLY defaults (`.local` is not
# routable); production must set a deliverable address on a controlled domain —
# the production guard rejects the default and reserved domains.
MAIL_FROM_EMAIL=no-reply@orgistry.local
MAIL_FROM_NAME=Orgistry
# Socket timeout for one SMTP delivery attempt, in milliseconds.
MAIL_TIMEOUT_MS=10000

# ----- Production SMTP endpoint (only read when MAIL_DRIVER=smtp) -----
# Leave unset for local development. When MAIL_DRIVER=smtp, HOST/USERNAME/
# PASSWORD are required (any NODE_ENV). Port 465 = SMTPS (implicit TLS) — the
# adapter always uses TLS; there is no insecure-transport toggle. NEVER commit
# a real credential; production also rejects placeholder-style passwords.
#SMTP_HOST=smtp.example-provider.com
#SMTP_PORT=465
#SMTP_USERNAME=orgistry-mailer
#SMTP_PASSWORD=

# ----- Mailpit (local email flows; only read when MAIL_DRIVER=mailpit) -----
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ----- Invitations -----
# Raw invitation token lifetime in seconds. Default: 7 days.
INVITATION_TTL_SECONDS=604800

# ----- Email verification -----
# Raw email-verification token lifetime in seconds. Default: 24 hours.
EMAIL_VERIFICATION_TTL_SECONDS=86400

# ----- Password recovery -----
# Raw password-reset token lifetime in seconds. Deliberately short (the link
# authorizes replacing the account password). Default: 1 hour.
PASSWORD_RESET_TTL_SECONDS=3600

# ----- Auth secrets -----
# LOCAL DEVELOPMENT VALUE — must never be copied into production. In
# production, generate a dedicated secret from at least 32 random bytes,
# hex-encoded (64 hex characters):
#   openssl rand -hex 32
# NODE_ENV=production refuses known development defaults, values shorter than
# 32 characters, placeholder-style values (change-me, dev-only, ...), and
# single-repeated-character values.
# (COOKIE_SECRET was removed in Sprint 15: no code path signs cookies, so the
# variable was dead config. A leftover value in an old .env is ignored.)
JWT_SECRET=dev-only-jwt-secret-change-me
# false on localhost over HTTP (browsers drop `Secure` cookies on plain HTTP);
# REQUIRED to be true when NODE_ENV=production — config refuses to load
# otherwise, even behind a TLS-terminating reverse proxy.
# Drives the refresh cookie's `Secure` attribute.
COOKIE_SECURE=false
# Access token lifetime in seconds (short-lived). Default: 15 minutes.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Session lifetime in seconds (outlives any single access token). Default: 30 days.
AUTH_SESSION_TTL_SECONDS=2592000
# Refresh token lifetime in seconds; also the refresh cookie Max-Age. Default: 30 days.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# ----- Refresh cookie + CSRF -----
# Refresh cookie name and path scope. The cookie is always HttpOnly + SameSite=Lax.
AUTH_REFRESH_COOKIE_NAME=orgistry_rt
AUTH_REFRESH_COOKIE_PATH=/v1/auth
# Custom header required on cookie-backed mutations (refresh/logout). Case-insensitive.
AUTH_CSRF_HEADER_NAME=x-orgistry-csrf

# ----- Generic rate limit namespace (not used by the auth buckets below) -----
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100

# ----- Auth rate-limit buckets (Redis-backed; fixed-window, one shared length) -----
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_IP_MAX=10
RATE_LIMIT_LOGIN_PER_EMAIL_MAX=5
RATE_LIMIT_REGISTER_PER_IP_MAX=5
# Registration per-email bucket (keyed on a digest of the normalized email):
# bounds duplicate-email probing independent of the caller's IP pool.
RATE_LIMIT_REGISTER_PER_EMAIL_MAX=3
RATE_LIMIT_REFRESH_PER_SESSION_MAX=60
RATE_LIMIT_REFRESH_PER_IP_MAX=120
# Authenticated credential mutations (per user). Low ceilings by design.
RATE_LIMIT_CHANGE_PASSWORD_PER_USER_MAX=5
RATE_LIMIT_CHANGE_EMAIL_PER_USER_MAX=3
# Email verification shares the auth window. Request/resend is authenticated
# (per user + per IP); completion is public (per IP).
RATE_LIMIT_EMAIL_VERIFICATION_REQUEST_PER_USER_MAX=3
RATE_LIMIT_EMAIL_VERIFICATION_REQUEST_PER_IP_MAX=10
RATE_LIMIT_EMAIL_VERIFICATION_COMPLETE_PER_IP_MAX=10
# Password recovery shares the auth window. Request is public (per IP + per
# normalized-email digest); completion is public (per IP + per token-derived
# internal key). No raw email or token material enters a limiter key.
RATE_LIMIT_PASSWORD_RECOVERY_REQUEST_PER_IP_MAX=5
RATE_LIMIT_PASSWORD_RECOVERY_REQUEST_PER_EMAIL_MAX=3
RATE_LIMIT_PASSWORD_RECOVERY_COMPLETE_PER_IP_MAX=10
RATE_LIMIT_PASSWORD_RECOVERY_COMPLETE_PER_TOKEN_MAX=5

# ----- External API rate-limit buckets (Redis-backed; per key + per org) -----
RATE_LIMIT_EXTERNAL_WINDOW_SECONDS=60
RATE_LIMIT_EXTERNAL_PER_KEY_MAX=120
RATE_LIMIT_EXTERNAL_PER_ORG_MAX=600

# ----- API keys -----
# Minimum seconds between last_used_at writes for a single key (write throttling).
API_KEY_LAST_USED_THROTTLE_SECONDS=60
