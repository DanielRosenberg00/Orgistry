# Orgistry deployment configuration — TEMPLATE (Sprint 26, ORG-PR-001).
#
# Copy this file to the deployment host, fill it in, and pass it to the
# deployment tooling:
#
#   tooling/deploy.sh --manifest release-manifest.json --config /etc/orgistry/deploy.env
#
# TWO FILES, TWO PURPOSES — do not merge them:
#
#   deploy.env   (this file)  HOW to deploy: environment name, image ports,
#                             network, evidence location, preflight policy.
#                             Contains NO secrets and MAY be committed to an
#                             operator's own infrastructure repository.
#
#   runtime.env               WHAT the application runs with: every value from
#                             the runtime configuration contract, including
#                             every runtime SECRET. Never committed anywhere,
#                             mode 0600, owned by the deploying user. The
#                             deployment refuses to run if it is group- or
#                             world-readable.
#
# The runtime configuration contract itself — every variable, its class, and
# its production rules — is documented once in docs/deployment.md
# ("Deployment configuration contract"), which builds on docs/runtime-secrets.md
# and docs/deployment-artifacts.md. It is deliberately NOT duplicated here.
#
# Image identity is NOT configured here. The API and web digests come from the
# release manifest, so a stale value in a configuration file can never decide
# what runs (docs/deployment.md, "Build once, promote by digest").
#
# The browser's public configuration IS here, deliberately: it is deployment
# state rather than artifact identity, which is what makes one web digest
# promotable between environments instead of rebuildable per environment.
#
# Format: KEY=VALUE, `#` comments, optional surrounding quotes. The file is
# PARSED, not sourced — command substitution in a value is refused, not run.

# ---- Identity -------------------------------------------------------------

# Environment name. Appears in every deployment record and selects the ledger
# subtree, so it must be stable for the life of the environment. Use the
# taxonomy names from docs/deployment.md: staging-like, production,
# rehearsal-local.
ORGISTRY_ENVIRONMENT=staging-like

# What kind of environment this is. `deployment` (the default) accepts ONLY a
# published release that declares itself deployable — which the release manifest
# schema grants only when the required checks succeeded for that exact commit.
# `rehearsal` is the explicit opt-in used by tooling/deploy-rehearsal.sh so a
# local, non-deployable rehearsal release can be deployed to a throwaway target.
# A real environment must never set this to `rehearsal`.
ORGISTRY_ENVIRONMENT_CLASS=deployment

# Docker Compose project name. All Orgistry containers on this host share it.
ORGISTRY_COMPOSE_PROJECT=orgistry

# ---- Runtime configuration and evidence ----------------------------------

# Absolute path to the runtime configuration file described above. Must be
# mode 0600.
ORGISTRY_RUNTIME_ENV_FILE=/etc/orgistry/runtime.env

# Append-only deployment evidence ledger. Answers "what is running here?" and
# "what would a rollback restore?", and holds a copy of every deployed release
# manifest. Back it up with the host; it contains no secrets.
ORGISTRY_EVIDENCE_DIR=/var/lib/orgistry/deployments

# ---- Network and published ports -----------------------------------------

# Docker network the deployment attaches to. Created by tooling/deploy.sh if
# missing. Operator-provided services on the same host (a database container, a
# reverse proxy) can be attached to it independently.
ORGISTRY_DEPLOY_NETWORK=orgistry-deploy

# Host ports. The defaults bind LOOPBACK ONLY: in a real deployment the
# operator's TLS-terminating reverse proxy is the only thing that should reach
# these. Set a bind address of 0.0.0.0 only deliberately, and only behind a
# host firewall.
ORGISTRY_API_BIND=127.0.0.1
ORGISTRY_API_HOST_PORT=3000
ORGISTRY_WEB_BIND=127.0.0.1
ORGISTRY_WEB_HOST_PORT=8080

# ---- Public browser configuration ----------------------------------------

# The API origin a BROWSER will use. This is applied to the web container at
# START, not compiled into the image, which is what lets one validated web
# digest be promoted from this environment to another. PUBLIC by definition —
# every browser receives it. Never put a secret in an ORGISTRY_PUBLIC_* value.
ORGISTRY_PUBLIC_API_BASE_URL=https://api.example.test

# Optional; the defaults match the application's own. The CSRF header name must
# match the API's AUTH_CSRF_HEADER_NAME.
# ORGISTRY_PUBLIC_CSRF_HEADER_NAME=x-orgistry-csrf
#
# ORGISTRY_PUBLIC_MAILPIT_URL is a link handed to the VISITOR'S BROWSER, so
# `localhost` there means the visitor's own machine — not this host. The default
# below is only useful to a developer running Mailpit locally. A deployed
# staging sink should stay bound to the host's loopback (captured messages carry
# raw verification tokens), so inspect it over an SSH tunnel rather than setting
# this to a public address. See docs/deployment.md, "The public Mailpit URL is
# not a remote inbox".
# ORGISTRY_PUBLIC_MAILPIT_URL=http://localhost:8025

# ---- Post-deployment smoke ------------------------------------------------

# Where the DEPLOYING HOST reaches the deployment. Usually the loopback ports
# above, because smoke runs on the host, before/behind the public edge.
ORGISTRY_SMOKE_API_URL=http://127.0.0.1:3000
ORGISTRY_SMOKE_WEB_URL=http://127.0.0.1:8080

# The public API origin smoke expects the deployment to have configured the
# browser with. Defaults to ORGISTRY_PUBLIC_API_BASE_URL, which is almost always
# what you want; set it only if the two must deliberately differ.
# ORGISTRY_SMOKE_EXPECTED_API_ORIGIN=https://api.example.test

# ---- Backup / recovery-point preflight -----------------------------------

# `take` (default) runs tooling/db-backup.sh against the deployment database
# before migrations and records the resulting recovery point. `skip` requires
# an explicit reason, which is written into the deployment record — an
# unexplained skip is refused.
ORGISTRY_BACKUP_PREFLIGHT=take
ORGISTRY_BACKUP_DIR=/var/lib/orgistry/backups
# ORGISTRY_BACKUP_SKIP_REASON=The managed database provider takes a verified
# automatic snapshot before every maintenance window.

# Docker network on which the DATABASE is reachable, if it runs as a container
# on this host. Leave unset for a managed/external database: the PostgreSQL
# client container then reaches it through the host gateway.
# ORGISTRY_DATABASE_DOCKER_NETWORK=orgistry-deploy

# ---- Migration verification ----------------------------------------------

# `on` (default) queries the Drizzle migration ledger after migrating and
# refuses the deployment unless the applied head matches the release manifest.
# Set to `off` only when the deploying host genuinely cannot reach the
# database — the deployment then records that the head was not verified.
ORGISTRY_MIGRATION_VERIFY=on
