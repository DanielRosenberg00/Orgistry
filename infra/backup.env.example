# Orgistry backup programme configuration — TEMPLATE (Sprint 28, ORG-PR-005).
#
# Copy to the deployment host as /opt/orgistry/config/backup.env, fill it in,
# and `chmod 600` it. It is read by every backup operation:
#
#   node tooling/backup-ops.mjs verify-store --config /opt/orgistry/config/backup.env
#   tooling/backup-install-systemd.sh --config /opt/orgistry/config/backup.env
#
# THREE FILES, THREE PURPOSES — do not merge them:
#
#   deploy.env    HOW to deploy      (infra/deploy.env.example)
#   runtime.env   WHAT the app runs with, including every application secret
#   backup.env    (this file) HOW the database is protected
#
# THIS FILE IS NOT A SECRET STORE. Every credential below is named by a
# `*_FILE` variable pointing at its own mode-0600 file, matching the host's
# existing convention (postgres-password, jwt-secret). That keeps this file
# reviewable and quotable in a runbook. The inline (non-`_FILE`) forms exist for
# CI and throwaway rehearsals and should not be used on a real host.
#
# Format: KEY=VALUE, `#` comments, optional surrounding quotes. PARSED, never
# sourced — a command substitution in a value is refused, not run.

# ---- Identity -------------------------------------------------------------

# Namespaces every stored object and appears in every recovery point. Must be a
# lowercase dashed name and must stay stable for the life of the environment:
# changing it makes the previous environment's backups invisible to the catalog.
ORGISTRY_BACKUP_ENVIRONMENT=staging-like

# ---- Source database ------------------------------------------------------

# Connection URL for the BACKUP role. Least privilege: see docs/backup-and-restore.md
# ("Credential model") for exactly what this role needs and what it must not have.
ORGISTRY_BACKUP_DATABASE_URL_FILE=/opt/orgistry/config/backup-database-url

# Docker network on which the database is reachable, when it runs as a
# container on this host. Leave unset for a managed database — the PostgreSQL
# client container then reaches it through the host gateway.
ORGISTRY_BACKUP_DATABASE_DOCKER_NETWORK=orgistry-deploy

# ---- Local paths ----------------------------------------------------------

# Where backups are staged before upload, and where a small number of recent
# copies are kept for a fast local restore. Mode 0700.
ORGISTRY_BACKUP_DIR=/opt/orgistry/backups

# The directory PostgreSQL's archive_command copies sealed WAL segments into.
# Must be the HOST side of the bind mount configured by
# tooling/pg-enable-wal-archiving.sh. It is a hand-off buffer, not storage: the
# shipper empties it every two minutes.
ORGISTRY_BACKUP_WAL_SPOOL_DIR=/opt/orgistry/data/wal-archive

# Where scheduled jobs record their last outcome, so a health check can see a
# FAILED run even while an older artifact is still inside its age window.
ORGISTRY_BACKUP_STATE_DIR=/opt/orgistry/backups/state

# ---- Encryption -----------------------------------------------------------

# 32 bytes as 64 hex characters. Generate with:  openssl rand -hex 32
#
# LOSING THIS KEY LOSES EVERY BACKUP ENCRYPTED WITH IT. Keep a copy somewhere
# that does not depend on this host and does not depend on the backup bucket.
# It must never be committed, never appear in a log, and never appear in
# evidence — the tooling identifies it by fingerprint only.
ORGISTRY_BACKUP_ENCRYPTION_KEY_FILE=/opt/orgistry/config/backup-encryption-key

# ---- Off-host object storage ----------------------------------------------

# S3-compatible endpoint. Choose a region OUTSIDE the source host's own region
# so the backups survive losing that region, not merely losing the host.
ORGISTRY_BACKUP_STORE_ENDPOINT=https://ams3.digitaloceanspaces.com
ORGISTRY_BACKUP_STORE_REGION=ams3
ORGISTRY_BACKUP_STORE_BUCKET=orgistry-backups

# Key namespace inside the bucket. Defaults to orgistry/<environment>.
# ORGISTRY_BACKUP_STORE_PREFIX=orgistry/staging-like

# Access key id is an identifier, not a secret; the secret lives in its own file.
ORGISTRY_BACKUP_STORE_ACCESS_KEY_ID=
ORGISTRY_BACKUP_STORE_SECRET_ACCESS_KEY_FILE=/opt/orgistry/config/backup-store-secret

# Path-style addressing (default `on`) is the form every S3-compatible provider
# accepts. Set `off` only for a provider that requires virtual-host addressing.
# ORGISTRY_BACKUP_STORE_PATH_STYLE=on

# ---- Artifact lifecycle ---------------------------------------------------
#
# This is BACKUP ARTIFACT retention. It is unrelated to the application's own
# table retention (`pnpm db:retention`, docs/retention.md), which deletes
# expired product rows and has nothing to do with recoverability.

# Keep logical backups for this many days...
ORGISTRY_BACKUP_RETAIN_LOGICAL_DAYS=30
# ...but never drop below this many, whatever the age window says. This is the
# guard that stops a misconfigured window leaving an environment unprotected.
ORGISTRY_BACKUP_RETAIN_LOGICAL_MIN=7
# WAL retention bounds the point-in-time recovery window. Pruning additionally
# refuses to delete WAL that the oldest surviving base backup still needs.
ORGISTRY_BACKUP_RETAIN_WAL_DAYS=8

# ---- Health thresholds ----------------------------------------------------

# A daily backup is unhealthy once it is older than this. 26h leaves room for
# the timer's jitter and a missed run being caught up.
ORGISTRY_BACKUP_MAX_AGE_HOURS=26
# WAL is unhealthy once the newest archived segment is older than this. Keep it
# consistent with archive_timeout (default 300s) plus the shipping interval.
ORGISTRY_BACKUP_WAL_MAX_AGE_MINUTES=15
